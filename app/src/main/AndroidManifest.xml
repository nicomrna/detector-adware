<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Necesario para listar apps de terceros instaladas (Android 11+ requiere <queries> o este permiso) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Necesario para detectar instalaciones en tiempo real -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Necesario para mostrar notificaciones de alerta (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Necesario para lanzar la pantalla de desinstalación -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
    android:allowBackup="true"
    android:icon="@android:drawable/sym_def_app_icon"
    android:roundIcon="@android:drawable/sym_def_app_icon"
    android:label="@string/app_name"
    android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Receiver que escucha instalaciones nuevas (PACKAGE_ADDED).
            android:exported="true" es obligatorio porque el sistema envía este broadcast
            desde fuera del propio proceso de la app.
        -->
        <receiver
            android:name=".receiver.InstallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Receiver que atiende la acción "Desinstalar" desde la notificación -->
        <receiver
            android:name=".receiver.NotificationActionReceiver"
            android:exported="false" />

    </application>

</manifest>
